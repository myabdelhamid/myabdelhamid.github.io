---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../config";
import "../../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Detailed overview of the Agentic HybridRAG Knowledge Base project" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>Agentic HybridRAG Knowledge Base - {siteConfig.name}</title>
  </head>
  <body class="bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-gray-100 min-h-screen">
    
    <main class="container mx-auto px-4 py-16 max-w-4xl">
      <!-- Back Button -->
      <a 
        href="/" 
        class="inline-flex items-center text-blue-400 hover:text-blue-300 mb-8 transition-colors"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Portfolio
      </a>

      <!-- Project Header -->
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-blue-400 to-purple-400 bg-clip-text text-transparent">
          Agentic HybridRAG Knowledge Engine
        </h1>
        <p class="text-xl text-gray-300">
          Production-grade Retrieval-Augmented Generation system combining vector search, knowledge graphs, and intelligent agentic reasoning with local LLMs
        </p>
      </div>

      <!-- Video Section -->
      <div class="mb-12 rounded-lg overflow-hidden shadow-2xl bg-gray-800">
        <div class="aspect-video bg-gray-700 flex items-center justify-center">
          <video 
            controls 
            class="w-full h-full"
          >
            <source src="/agentic-hybridrag-demo.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>
      </div>

      <!-- Project Description -->
      <section class="mb-12">
        <h2 class="text-3xl font-bold mb-6 text-blue-400">Project Overview</h2>
        <div class="prose prose-invert prose-lg max-w-none">
          <p class="text-gray-300 mb-4">
            A sophisticated RAG system that uses phi3:mini for intelligent routing between vector databases and knowledge graphs, 
            with two-phase extraction to prevent relation loss across document chunks. The system achieves 97% relation preservation 
            compared to 53% with traditional chunk-local methods.
          </p>
          
          <h3 class="text-2xl font-semibold mt-8 mb-4 text-purple-400">Key Features</h3>
          <ul class="space-y-2 text-gray-300">
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Intelligent Agentic Routing:</strong> LLM-powered agent automatically selects optimal retrieval strategy - vector-only for explanations, graph-only for facts, or hybrid for comparisons</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Two-Phase Extraction Pipeline:</strong> Solves cross-chunk relation problem with global entity registry, reducing relation loss from 47% to just 3%</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Anti-Hallucination Grounding:</strong> Strict prompt engineering prevents LLMs from inventing facts or using external knowledge</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>100% Local Deployment:</strong> Runs entirely with Ollama - no API costs, ensuring data privacy and security</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Fully Tested:</strong> 56/56 comprehensive tests passing covering planning, vector retrieval, graph retrieval, and end-to-end integration</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Production-Ready:</strong> Docker-deployed with one-command setup, battle-tested on multi-document knowledge bases</span>
            </li>
          </ul>

          <h3 class="text-2xl font-semibold mt-8 mb-4 text-purple-400">Technical Stack</h3>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm">Python</span>
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm">FastAPI</span>
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm">React</span>
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm">Ollama</span>
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm">Neo4j</span>
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm">ChromaDB</span>
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm">Docker</span>
            <span class="px-3 py-1 bg-blue-500/20 text-blue-300 rounded-full text-sm">LangChain</span>
          </div>

          <h3 class="text-2xl font-semibold mt-8 mb-4 text-purple-400">Performance Benchmarks</h3>
          <p class="text-gray-300 mb-4">
            The system demonstrates exceptional performance across key metrics:
          </p>
          <ul class="space-y-2 text-gray-300">
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Entity Extraction:</strong> 95% accuracy with LLM-based extraction (phi3:mini), compared to 70% with spaCy NER</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Relation Recall:</strong> 92% with two-phase extraction vs 45% with traditional methods</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Cross-Chunk Relations:</strong> 97% preserved (up from 53% with chunk-local extraction)</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Query Response Time:</strong> 0.5s for factual queries, 1.2s for explanatory, 1.8s for hybrid comparisons</span>
            </li>
          </ul>

          <h3 class="text-2xl font-semibold mt-8 mb-4 text-purple-400">Implementation Highlights</h3>
          <p class="text-gray-300 mb-4">
            This project showcases advanced AI engineering principles with a multi-agent architecture where specialized agents 
            handle different aspects of the query processing pipeline:
          </p>
          <ul class="space-y-2 text-gray-300">
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Phase 1 - Entity Discovery:</strong> Scans all document chunks to build a global entity registry with deduplication</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Phase 2 - Relation Extraction:</strong> Uses global entity context to extract relationships, preventing cross-chunk information loss</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span><strong>Agentic Routing:</strong> Analyzes question semantics to determine optimal retrieval strategy (vector/graph/hybrid)</span>
            </li>
          </ul>

          <h3 class="text-2xl font-semibold mt-8 mb-4 text-purple-400">Key Contributions</h3>
          <ul class="space-y-2 text-gray-300">
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span>Solves the chunk boundary problem in multi-document RAG systems</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span>Global entity registry for cross-chunk entity tracking and relation validation</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span>Automatic database selection based on question semantics using agentic reasoning</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-400 mr-2">•</span>
              <span>Comprehensive test suite ensuring production reliability</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- Links Section -->
      <section class="flex flex-wrap gap-4">
        <a 
          href="https://github.com/myabdelhamid/GraphRAG-Assistant" 
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors shadow-lg"
        >
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          View on GitHub
        </a>
      </section>
    </main>
    <!-- Scroll to Top Button -->
    <button
      id="scrollToTop"
      class="fixed bottom-8 right-8 w-12 h-12 bg-blue-600 hover:bg-blue-700 text-white rounded-full shadow-lg transition-all duration-300 opacity-0 pointer-events-none flex items-center justify-center z-50"
      aria-label="Scroll to top"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </button>
    <Footer />
  </body>
</html>

<style>
  body {
    font-family: 'IBM Plex Mono', monospace;
  }

  #scrollToTop.show {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  const scrollToTopBtn = document.getElementById('scrollToTop');
  
  // Show button when user scrolls down
  window.addEventListener('scroll', () => {
    if (window.scrollY > 300) {
      scrollToTopBtn?.classList.add('show');
    } else {
      scrollToTopBtn?.classList.remove('show');
    }
  });
  
  // Scroll to top when button is clicked
  scrollToTopBtn?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  });
</script>